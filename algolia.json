{
  "index_name": "modyo_docs_index",
  "start_urls": [
    {
      "url": "https://docs.modyo.com/es/",
      "selectors_key": "es",
      "tags": [
        "es"
      ]
    },
    {
      "url": "https://es.modyo.com/comunidad/developer-tips",
      "selectors_key": "es",
      "tags": [
        "es"
      ]
    },
    {
      "url": "https://docs.modyo.com/en/",
      "selectors_key": "en",
      "tags": [
        "en"
      ]
    },
    {
      "url": "https://www.modyo.com/community/developer-tips",
      "selectors_key": "en",
      "tags": [
        "en"
      ]
    }
  ],
  "stop_urls": [],
  "selectors": {
    "es": {
      "lvl0": {
        "selector": ".VPSidebarItem.level-0.has-active > .item .text",
        "global": true,
        "default_value": "Documentation"
      },
      "lvl1": ".vp-doc h1",
      "lvl2": ".vp-doc h2",
      "lvl3": ".vp-doc h3",
      "lvl4": ".vp-doc h4",
      "lvl5": ".vp-doc h5",
      "text": ".vp-doc p, .vp-doc li",
      "lang": {
        "selector": "/html/@lang",
        "type": "xpath",
        "global": true
      }
    },
    "en": {
      "lvl0": {
        "selector": ".VPSidebarItem.level-0.has-active > .item .text",
        "global": true,
        "default_value": "Documentation"
      },
      "lvl1": ".vp-doc h1",
      "lvl2": ".vp-doc h2",
      "lvl3": ".vp-doc h3",
      "lvl4": ".vp-doc h4",
      "lvl5": ".vp-doc h5",
      "text": ".vp-doc p, .vp-doc li",
      "lang": {
        "selector": "/html/@lang",
        "type": "xpath",
        "global": true
      }
    }
  },
  "scrape_start_urls": false,
  "strip_chars": " .,;:#\u200b",
  "custom_settings": {
    "attributesForFaceting": [
      "lang",
      "tags"
    ]
  }
}
